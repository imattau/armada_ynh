#!/bin/bash
set -eu

source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression --message="Setting up Armada source files..." --weight=1
ynh_setup_source --source_id=main

ynh_script_progression --message="Building Armada frontend..." --weight=5
build_armada

ynh_script_progression --message="Configuring Nginx..." --weight=1
ynh_add_nginx_config

ynh_script_progression --message="Armada installation complete" --last
